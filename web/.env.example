# API target used by the Vite dev server proxy.
# Defaults to the local backend on http://127.0.0.1:18888.
VITE_PROXY_TARGET=http://127.0.0.1:18888

# Admin console dev proxy (npm run dev:admin)
VITE_ADMIN_PROXY_TARGET=http://127.0.0.1:18888

# Canonical site URL used for SEO meta tags
VITE_SITE_URL=http://localhost:5173
